{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "padding": {
            "top": 1,
            "left": 2
        }
    },

    "display": {
        "separator": " ➜ "
    },

    "modules": [
        "break",

        {
            "type": "title",
            "keyWidth": 10
        },

        "break",

        {
            "type": "os",
            "key": " OS"
        },
        {
            "type": "host",
            "key": "󰌢 PC"
        },
        {
            "type": "kernel",
            "key": "󰒋 Kernel"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime"
        },

        "break",

        {
            "type": "packages",
            "key": "󰏖 Pkgs"
        },
        {
            "type": "shell",
            "key": " Shell"
        },
        {
            "type": "terminal",
            "key": " Terminal"
        },

        {
            "type": "wm",
            "key": " WM"
        },

        {
            "type": "de",
            "key": "󰧨 DE"
        },

        "break",

        {
            "type": "cpu",
            "key": "󰍛 CPU"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "󰑭 RAM"
        },

        "break",

        {
            "type": "disk",
            "key": "󰋊 Disk",
            "folders": [
                "/"
            ]
        },

        {
            "type": "localip",
            "key": "󰩠 IP"
        },

        {
            "type": "battery",
            "key": "󰁹 Battery"
        },

        "break",

        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "●"
        }
    ]
}
