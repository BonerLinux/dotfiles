#!/usr/bin/env nix-shell
#!nix-shell -i bash -p bash stow git jq
set -euo pipefail

DOTFILES_TARGET="$HOME/.dotfiles"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(dirname "$SCRIPT_DIR")

cmd_rebuild() {
    sudo nixos-rebuild switch --flake "$HOME/.dotfiles/nixos#" --impure
}

cmd_update() {
    echo "Updating flake inputs..."
    nix flake update --flake "$DOTFILES_TARGET/nixos"

    if git -C "$DOTFILES_TARGET" diff --quiet -- nixos/flake.lock; then
        echo "flake.lock unchanged."
    else
        echo "Committing updated flake.lock..."
        git -C "$DOTFILES_TARGET" add nixos/flake.lock
        git -C "$DOTFILES_TARGET" commit -m "nixos: update flake.lock"
        git -C "$DOTFILES_TARGET" push
    fi

    cmd_rebuild
}

cmd_secrets() {
    local subcmd="${1:-list}"
    case "$subcmd" in
        update) cmd_secrets_update "${2:-}" ;;
        list) cmd_secrets_list ;;
        *)
            echo "Usage: boner secrets [update NAME]" >&2
            exit 1
            ;;
    esac
}

cmd_secrets_list() {
    local rules="$DOTFILES_TARGET/nixos/secrets/secrets.nix"
    local admin_key host_key

    admin_key=$(awk -F': ' '/^# public key:/ {print $2}' "$HOME/.config/agenix/key.txt" 2>/dev/null || true)
    host_key=$(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub 2>/dev/null || true)

    nix eval --json --file "$rules" | jq -r \
        --arg admin "$admin_key" --arg host "$host_key" '
        to_entries[]
        | select(.value.publicKeys | index($admin) or index($host))
        | .key
        | sub("\\.age$"; "")
    '
}

cmd_secrets_update() {
    local name="${1:?Usage: boner secrets update NAME}"
    name="${name%.age}.age"
    local secret_file="$DOTFILES_TARGET/nixos/secrets/$name"
    local before after

    before=$(sha256sum "$secret_file" 2>/dev/null | cut -d' ' -f1 || true)

    case "$name" in
        git-credentials-*)
            echo "Format (whole line, not just the token):" >&2
            echo "  https://USERNAME:TOKEN@github.com" >&2
            echo "" >&2
            ;;
    esac

    (cd "$DOTFILES_TARGET/nixos/secrets" && nix run github:ryantm/agenix -- -e "$name" -i "$HOME/.config/agenix/key.txt")

    after=$(sha256sum "$secret_file" 2>/dev/null | cut -d' ' -f1 || true)

    if [ "$before" != "$after" ]; then
        echo "" >&2
        echo "$name changed -- commit it and run 'boner rebuild' for it to take effect." >&2
    fi
}

cmd_install() {
    if [ "$REPO_ROOT" != "$DOTFILES_TARGET" ]; then
        if [ -e "$DOTFILES_TARGET" ]; then
            echo "Error: $DOTFILES_TARGET already exists. Remove it first." >&2
            exit 1
        fi
        echo "Moving dotfiles to $DOTFILES_TARGET..."
        mv "$REPO_ROOT" "$DOTFILES_TARGET"
        exec "$DOTFILES_TARGET/scripts/boner" install
    fi

    echo "Stowing config files..."
    mkdir -p "$HOME/.config"
    stow --dir "$DOTFILES_TARGET" --target "$HOME/.config" config

    if [ ! -d "$HOME/.wallpapers" ]; then
        echo "Cloning wallpapers in the background (log: $HOME/.wallpapers-clone.log)..."
        nohup git clone https://github.com/dharmx/walls.git "$HOME/.wallpapers" \
            >"$HOME/.wallpapers-clone.log" 2>&1 &
        disown
    else
        echo "$HOME/.wallpapers already exists, skipping clone."
    fi

    echo "Done."
}

case "${1:-}" in
    install) cmd_install ;;
    rebuild) cmd_rebuild ;;
    update) cmd_update ;;
    secrets) cmd_secrets "${@:2}" ;;
    *)
        echo "Usage: boner <command>" >&2
        echo "" >&2
        echo "Commands:" >&2
        echo "  install               Move dotfiles to ~/.dotfiles, stow configs, clone wallpapers" >&2
        echo "  rebuild               Rebuild and switch NixOS configuration" >&2
        echo "  update                Update flake inputs, push flake.lock, and rebuild" >&2
        echo "  secrets               List agenix secrets decryptable by this key/host" >&2
        echo "  secrets update NAME   Edit/create a secret (opens \$EDITOR via agenix)" >&2
        exit 1
        ;;
esac
