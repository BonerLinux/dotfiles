#!/bin/sh

set -euo pipefail

USER_HOME=$(eval echo ~"$USER")
DOTFILES_DIR="$USER_HOME/.dotfiles"
NIX_DIR="$DOTFILES_DIR/nixos"

COMMAND="${1:-}"
SUBCOMMAND="${2:-}"

show_help() {
    cat <<EOF
boner - dotfiles management utility

Usage:
    boner install
    boner install dev
    boner update
    boner update push
    boner update pull
    boner create-installer
    boner rebuild
EOF
}

install_main() {
    echo "[TODO] install"
}

install_dev() {
    echo "[TODO] install dev"
}

update_main() {
    cd "$NIX_DIR"
    nix flake update

    git add flake.lock

    CURRENT_DATE=$(date +"%Y-%m-%d %H:%M:%S")

    git commit -m "flake update $CURRENT_DATE"

    git push
}

update_push() {
    echo "[TODO] update push"
}

update_pull() {
    echo "[TODO] update pull"
}

create_installer() {
    echo "[TODO] create installer"
}

rebuild() {
    sudo nixos-rebuild switch \
        --flake "$USER_HOME/.dotfiles/nixos#" \
        --impure
}

case "$COMMAND" in
    install)
        case "$SUBCOMMAND" in
            "")
                install_main
                ;;
            dev)
                install_dev
                ;;
            *)
                echo "Unknown install option: $SUBCOMMAND"
                exit 1
                ;;
        esac
        ;;

    update)
        case "$SUBCOMMAND" in
            "")
                update_main
                ;;
            push)
                update_push
                ;;
            pull)
                update_pull
                ;;
            *)
                echo "Unknown update option: $SUBCOMMAND"
                exit 1
                ;;
        esac
        ;;

    create-installer)
        create_installer
        ;;

    rebuild)
        rebuild
        ;;

    help|-h|--help|"")
        show_help
        ;;

    *)
        echo "Unknown command: $COMMAND"
        echo
        show_help
        exit 1
        ;;
esac
