#!/bin/sh

WALLPAPER="$1"

if [ -z "$WALLPAPER" ]; then
    echo "Usage: set-wallpaper <path-to-image>" >&2
    exit 1
fi

if [ ! -f "$WALLPAPER" ]; then
    echo "No such file: $WALLPAPER" >&2
    exit 1
fi

HYPRTOOLKIT_CONFIG="$HOME/.config/hypr/hyprtoolkit.conf"
WAL="$HOME/.cache/wal/colors"
WAL_JSON="$HOME/.cache/wal/colors.json"
QT6CT_DIR="$HOME/.config/qt6ct"

# Wait for hyprpaper IPC socket to be ready before issuing wallpaper commands
until [ -S "/run/user/$(id -u)/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.hyprpaper.sock" ]; do
    sleep 0.3
done

# Set wallpaper (hyprpaper v0.7+ handles load/unload automatically)
hyprctl hyprpaper wallpaper ",$WALLPAPER"

# Persist the chosen wallpaper so it survives restarts
ln -sf "$(realpath "$WALLPAPER")" "$HOME/.wallpaper"

# Generate Pywal colors
wal -i "$WALLPAPER"

# Read Pywal colors
background=$(sed -n '1p' "$WAL")
foreground=$(sed -n '2p' "$WAL")
color0=$(sed -n '3p' "$WAL")
color4=$(sed -n '7p' "$WAL")
color5=$(sed -n '8p' "$WAL")
color8=$(sed -n '11p' "$WAL")

# Generate HyprToolkit theme directly from Pywal
cat > "$HYPRTOOLKIT_CONFIG" <<EOF
background = 0xff${background#\#}
base = 0xff${color0#\#}
text = 0xff${foreground#\#}
alternate_base = 0xff${color8#\#}
bright_text = 0xff${foreground#\#}
accent = 0xff${color4#\#}
accent_secondary = 0xff${color5#\#}

h1_size = 22
h2_size = 17
h3_size = 14
font_size = 13
small_font_size = 11

icon_theme = "Papirus"
font_family = "Sans Serif"
font_family_monospace = "monospace"

rounding_large = 12
rounding_small = 8
EOF

# Generate a qt6ct color scheme from Pywal so Qt apps (e.g. the hyprpolkitagent
# authentication dialog) match the rest of the theme instead of falling back
# to Qt's default white palette
extract_wal_color() {
    grep "\"$1\"" "$WAL_JSON" | head -1 | sed -E 's/.*: *"(#[0-9A-Fa-f]+)".*/\1/'
}
argb() {
    printf 'ff%s' "$(printf '%s' "$1" | tr -d '#' | tr 'a-f' 'A-F')"
}

qt_bg=$(argb "$(extract_wal_color background)")
qt_fg=$(argb "$(extract_wal_color foreground)")
qt_muted=$(argb "$(extract_wal_color color8)")
qt_accent=$(argb "$(extract_wal_color color4)")
qt_accent2=$(argb "$(extract_wal_color color5)")
qt_red=$(argb "$(extract_wal_color color1)")

mkdir -p "$QT6CT_DIR/colors"

# Color order follows QPalette::ColorRole (WindowText..PlaceholderText), as
# read positionally by qt6ct's color scheme parser
cat > "$QT6CT_DIR/colors/pywal.conf" <<EOF
[ColorScheme]
active_colors=#$qt_fg, #$qt_muted, #$qt_accent2, #$qt_accent, #$qt_muted, #$qt_bg, #$qt_fg, #$qt_accent2, #$qt_fg, #$qt_bg, #$qt_bg, #$qt_bg, #$qt_accent, #$qt_bg, #$qt_accent, #$qt_red, #$qt_muted, #$qt_fg, #$qt_bg, #$qt_fg, #$qt_muted
disabled_colors=#$qt_muted, #$qt_muted, #$qt_accent2, #$qt_accent, #$qt_muted, #$qt_bg, #$qt_muted, #$qt_muted, #$qt_muted, #$qt_bg, #$qt_bg, #$qt_bg, #$qt_accent, #$qt_muted, #$qt_accent, #$qt_red, #$qt_muted, #$qt_muted, #$qt_bg, #$qt_muted, #$qt_muted
inactive_colors=#$qt_fg, #$qt_muted, #$qt_accent2, #$qt_accent, #$qt_muted, #$qt_bg, #$qt_fg, #$qt_accent2, #$qt_fg, #$qt_bg, #$qt_bg, #$qt_bg, #$qt_accent, #$qt_bg, #$qt_accent, #$qt_red, #$qt_muted, #$qt_fg, #$qt_bg, #$qt_fg, #$qt_muted
EOF

cat > "$QT6CT_DIR/qt6ct.conf" <<EOF
[Appearance]
style=Fusion
custom_palette=true
color_scheme_path=$QT6CT_DIR/colors/pywal.conf
icon_theme=Papirus
standard_dialogs=default
EOF

# Reload Hyprland
hyprctl reload

# Reload mako so notifications pick up the new colors
makoctl reload

# Restart swayosd so its OSD stylesheet picks up the new colors
pkill swayosd-server 2>/dev/null || true
sleep 0.3
swayosd-server &

# Restart Quickshell so it picks up the new colors
pkill quickshell 2>/dev/null || true
sleep 0.3
quickshell &

# Reload colors in running Neovim instances
pkill -SIGUSR1 nvim

# Restart Hyprlauncher so it picks up the new theme
pkill hyprlauncher 2>/dev/null || true
sleep 0.3
hyprlauncher -d >/dev/null 2>&1 &

# Restart hyprpolkitagent (runs as a systemd user service) so its Qt
# authentication dialog picks up the new qt6ct colors
systemctl --user restart hyprpolkitagent.service
