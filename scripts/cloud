#!/usr/bin/env nix-shell
#!nix-shell -i bash -p sshfs


mkdir ~/Recordings
sshfs server:/mnt/tank/files/Recordings ~/Recordings

mkdir ~/Documents
sshfs server:/mnt/tank/files/Documents ~/Documents

mkdir ~/Projects
sshfs server:/mnt/tank/files/Projects ~/Projects

mkdir ~/.obsidian
sshfs server:/mnt/tank/files/obsidian ~/.obsidian

